# ============ Storage-IOH ============
# Obrigatórios — gere valores aleatórios com: openssl rand -hex 32
APP_SECRET=troque-por-um-valor-aleatorio-de-64-chars
MEILI_MASTER_KEY=troque-por-outra-chave-aleatoria

# Usuário admin criado no primeiro start (só se não houver usuários)
ADMIN_EMAIL=admin@local
ADMIN_PASSWORD=troque-esta-senha

# ============ Opcionais ============
# Porta publicada da interface web
WEB_PORT=3000
# true quando estiver atrás de HTTPS
COOKIE_SECURE=false
# proxy (padrão, sem configurar CORS) | presigned (navegador baixa direto do provedor)
PREVIEW_MODE=proxy
# Tamanho máximo de upload por requisição (MB)
UPLOAD_MAX_MB=5120
# Tarefas de indexação em paralelo
WORKER_CONCURRENCY=4
# true para gerar miniaturas de vídeo (instala ffmpeg na imagem)
WITH_FFMPEG=false
POSTGRES_PASSWORD=ioh
# Fuso horário usado em relatórios (CSV) e logs
TZ=America/Sao_Paulo

# ============ Backups ERP ============
# URL pública do app (usada em links de compartilhamento, scripts de envio e alertas)
PUBLIC_URL=
# De quanto em quanto tempo o local de backup de cada cliente é verificado
SCAN_INTERVAL_MINUTES=15
# Tamanho máximo de um backup enviado por token (GB)
INGEST_MAX_GB=500
# E-mail para alertas (opcional). Porta 465 = TLS direto; 587 = STARTTLS
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Backups <backups@suaempresa.com.br>

# ============ Autocadastro de clientes (opcional) ============
# O aplicativo do cliente envia nome + CNPJ em POST /api/enroll e recebe a chave de integração.
# Vazio = desligado. Gere com: openssl rand -hex 24 (vai embutido no aplicativo do cliente)
ENROLL_SECRET=
# Onde os backups dos clientes novos serão gravados (ID da conexão em Conexões + bucket)
ENROLL_CONNECTION_ID=
ENROLL_BUCKET=
ENROLL_PREFIX=clientes/
